# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
sdist/
.Python
.installed.cfg

# --- Python: tooling caches and coverage ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ty/
.hypothesis/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
